</main>
<footer class="foot">
  <div class="foot__topo"><%- topo.band %></div>
  <div class="wrap foot__grid">
    <div>
      <p class="foot__brand">Shea <em>Land Management</em></p>
      <p><%= site.base %>, <%= site.state %> <%= site.zip %><br>Serving all 15 towns on Cape Cod</p>
      <% if (site.phone) { %><p><a href="<%= site.phoneHref %>" data-track="call_click" data-label="footer"><%= site.phone %></a></p><% } %>
      <% if (site.email) { %><p><a href="mailto:<%= site.email %>" data-track="email_click" data-label="footer"><%= site.email %></a></p><% } %>
      <% if (site.facebook) { %><p><a href="<%= site.facebook %>" rel="noopener">Facebook</a></p><% } %>
    </div>
    <div>
      <h2>Services</h2>
      <ul><% services.forEach(function (s) { %><li><a href="/services/<%= s.slug %>"><%= s.name %></a></li><% }) %></ul>
      <h2>Company</h2>
      <ul><li><a href="/estimate">Instant estimate</a></li><li><a href="/about">About</a></li><li><a href="/articles">Articles</a></li><li><a href="/contact">Request a quote</a></li></ul>
    </div>
    <div class="foot__towns">
      <h2>Service areas</h2>
      <ul><% towns.forEach(function (t) { %><li><a href="/service-areas/<%= t.slug %>"><%= t.name %></a></li><% }) %></ul>
    </div>
  </div>
  <div class="wrap foot__base"><span>&copy; <%= year %> <%= site.legalName %></span><span><a href="/sitemap.xml">Sitemap</a></span></div>
</footer>
<% if (site.phone) { %><a class="callbar" href="<%= site.phoneHref %>" data-track="call_click" data-label="mobile bar">Call <%= site.phone %></a><% } %>
<script src="/js/site.js?v=4" defer></script>
</body>
</html>
