<div class="tix">
  <% ['Upper Cape', 'Mid Cape', 'Lower Cape', 'Outer Cape'].forEach(function (area) { %>
  <div class="tix__col">
    <h3><%= area %></h3>
    <ul>
      <% towns.filter(function (t) { return t.area === area; }).forEach(function (t) { %>
      <li><a href="<%= locals.tixService ? '/services/' + tixService.slug + '/' + t.slug : '/service-areas/' + t.slug %>"><%= t.name %><% if (t.home) { %> <small>home base</small><% } %></a></li>
      <% }) %>
    </ul>
  </div>
  <% }) %>
</div>
